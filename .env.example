DATABASE_PATH=data/jobs.db
PROFILE_PATH=config/profile_keywords.yaml
PROFILE_SUMMARY_PATH=config/profile_summary.yaml

ENABLE_WEB_SEARCH=true
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_SECONDS=1.5
MAX_SEARCH_QUERIES=20

# O YAML define esses valores por padrao. Use aqui apenas para sobrescrever.
MIN_SCORE_TO_EMAIL=
MAX_EMAIL_JOBS=

EMAIL_DRY_RUN=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=jobradar@example.com
EMAIL_TO=seu-email@example.com

SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
